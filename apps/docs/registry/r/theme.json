{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Rabtx theme",
  "description": "The Rabtx colors, radius, depth, shadows and status tones as shadcn theme variables.",
  "cssVars": {
    "theme": {
      "color-subtle-foreground": "var(--subtle-foreground)",
      "color-disabled-foreground": "var(--disabled-foreground)",
      "color-success": "var(--success)",
      "color-warning": "var(--warning)",
      "color-violet": "var(--violet)",
      "color-field": "var(--field)",
      "ease-spring-press": "var(--spring-press)",
      "ease-spring-swap": "var(--spring-swap)",
      "ease-spring-label": "var(--spring-label)",
      "ease-spring-magnetic": "var(--spring-magnetic)",
      "ease-spring-unfold": "var(--spring-unfold)",
      "ease-spring-tabs": "var(--spring-tabs)",
      "ease-spring-panel": "var(--spring-panel)",
      "ease-spring-toast": "var(--spring-toast)",
      "ease-spring-switch": "var(--spring-switch)"
    },
    "light": {
      "radius": "0.5rem",
      "background": "#ffffff",
      "foreground": "#292929",
      "card": "#ffffff",
      "card-foreground": "#292929",
      "popover": "#ffffff",
      "popover-foreground": "#292929",
      "primary": "#2d7cf6",
      "primary-foreground": "#ffffff",
      "secondary": "#f5f5f5",
      "secondary-foreground": "#292929",
      "muted": "#f2f2f2",
      "muted-foreground": "#5d5d5d",
      "accent": "rgb(41 41 41 / 0.06)",
      "accent-foreground": "#292929",
      "destructive": "#e5484d",
      "border": "#f2f2f2",
      "input": "#e3e3e3",
      "ring": "#2d7cf6",
      "chart-1": "#2d7cf6",
      "chart-2": "#30a46c",
      "chart-3": "#f0803c",
      "chart-4": "#8e5cf0",
      "chart-5": "#e5484d",
      "sidebar": "#ffffff",
      "sidebar-foreground": "#292929",
      "sidebar-primary": "#2d7cf6",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "rgb(41 41 41 / 0.06)",
      "sidebar-accent-foreground": "#292929",
      "sidebar-border": "#f2f2f2",
      "sidebar-ring": "#2d7cf6",
      "subtle-foreground": "#9e9e9e",
      "disabled-foreground": "#a3a3a3",
      "success": "#30a46c",
      "warning": "#f0803c",
      "violet": "#8e5cf0",
      "tint-ink": "#000000",
      "field": "#f5f5f5",
      "field-disabled": "#fafafa",
      "field-edge-top": "rgb(0 0 0 / 0.14)",
      "field-edge-bottom": "rgb(0 0 0 / 0.05)",
      "field-shade": "rgb(0 0 0 / 0.04)",
      "surface-ring": "rgb(0 0 0 / 0.1)",
      "surface-edge-top": "#ffffff",
      "surface-edge-bottom": "rgb(0 0 0 / 0.08)",
      "surface-sheen": "rgb(255 255 255 / 0.5)",
      "surface-shade": "rgb(0 0 0 / 0.03)",
      "shadow-popover": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
      "shadow-raised": "0 8px 22px rgb(0 0 0 / 0.16)",
      "radius-button": "999px",
      "radius-item": "var(--radius)",
      "radius-control": "var(--radius)",
      "radius-box": "calc(var(--radius) * 1.5)",
      "radius-badge": "calc(var(--radius) * 0.5)",
      "radius-check": "calc(var(--radius) * 0.5)",
      "motion-ease": "cubic-bezier(0.25, 1, 0.5, 1)"
    },
    "dark": {
      "background": "#161616",
      "foreground": "#ebebeb",
      "card": "#212121",
      "card-foreground": "#ebebeb",
      "popover": "#212121",
      "popover-foreground": "#ebebeb",
      "primary": "#2d7cf6",
      "primary-foreground": "#ffffff",
      "secondary": "#1d1d1d",
      "secondary-foreground": "#ebebeb",
      "muted": "#303030",
      "muted-foreground": "#a3a3a3",
      "accent": "rgb(235 235 235 / 0.06)",
      "accent-foreground": "#ebebeb",
      "destructive": "#f0686d",
      "border": "#303030",
      "input": "#3d3d3d",
      "ring": "#6aa4fa",
      "chart-1": "#4a8ff7",
      "chart-2": "#30a46c",
      "chart-3": "#f0803c",
      "chart-4": "#8e5cf0",
      "chart-5": "#f0686d",
      "sidebar": "#161616",
      "sidebar-foreground": "#ebebeb",
      "sidebar-primary": "#2d7cf6",
      "sidebar-primary-foreground": "#ffffff",
      "sidebar-accent": "rgb(235 235 235 / 0.06)",
      "sidebar-accent-foreground": "#ebebeb",
      "sidebar-border": "#303030",
      "sidebar-ring": "#6aa4fa",
      "subtle-foreground": "#7f7f7f",
      "disabled-foreground": "#5f5f5f",
      "success": "#30a46c",
      "warning": "#f0803c",
      "violet": "#8e5cf0",
      "tint-ink": "#ffffff",
      "field": "#1b1b1b",
      "field-disabled": "#161616",
      "field-edge-top": "rgb(0 0 0 / 0.55)",
      "field-edge-bottom": "rgb(255 255 255 / 0.07)",
      "field-shade": "rgb(0 0 0 / 0.25)",
      "surface-ring": "rgb(0 0 0 / 0.6)",
      "surface-edge-top": "rgb(255 255 255 / 0.14)",
      "surface-edge-bottom": "rgb(0 0 0 / 0.4)",
      "surface-sheen": "rgb(255 255 255 / 0.05)",
      "surface-shade": "rgb(0 0 0 / 0.16)"
    }
  },
  "type": "registry:theme"
}
# apps/ai-api — copy to .env (gitignored) and adjust. Never commit real keys.
NODE_ENV=development
PORT=8000
LOG_LEVEL=INFO

# Postgres with the pgvector extension (docker compose: pgvector/pgvector:pg18 on host :5433).
DATABASE_URL=postgresql://starter:starter@localhost:5433/starter
DATABASE_POOL_MAX=5
# DATABASE_SSL=true

# Must equal apps/nest-api JWT_SECRET: ai-api verifies nest-issued access tokens.
JWT_SECRET=development-only-jwt-secret-change-me
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Any OpenAI-compatible endpoint. Defaults to OpenRouter (same as apps/docs).
AI_BASE_URL=https://openrouter.ai/api/v1
AI_PROVIDER_NAME=openrouter
# AI_API_KEY=
AI_CHAT_MODEL=openai/gpt-4o-mini
# Must return 1536 dimensions (the vector column size).
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional separate embeddings endpoint, e.g. https://api.openai.com/v1
# AI_EMBEDDING_BASE_URL=
# AI_EMBEDDING_API_KEY=

RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
CHAT_MAX_STEPS=5

# Opt-in integration test against real pgvector (a throwaway database):
# AI_API_TEST_DATABASE_URL=postgresql://starter:starter@localhost:5433/ai_api_test
